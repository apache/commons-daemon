include ../Makedefs

# Compile production sources separately so test flags never affect native objects.
SOURCES = test_home.c ../native/home.c ../native/replace.c ../native/location.c ../native/debug.c
HEADERS = $(wildcard ../native/*.h)

.PHONY: check clean

check: test_home
	sh ./check.sh

test_home: $(SOURCES) $(HEADERS) ../Makedefs
	$(CC) $(CFLAGS) $(CPPFLAGS) $(EXTRA_CFLAGS) $(INCLUDES) -I../native $(SOURCES) $(LDFLAGS) $(EXTRA_LDFLAGS) $(LIBS) -o $@

clean:
	rm -f test_home
	rm -rf test_home.dSYM
